{
  "name": "private-prompt-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Verifiable private AI: check a NEAR AI Cloud enclave, encrypt your prompt to its attested key, verify the signed reply.",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/",
    "start": "node scripts/serve.mjs",
    "verify": "node scripts/verify-receipt.mjs web/sample-run.json",
    "swap-test": "node scripts/verify-receipt.mjs web/sample-run.json --swap-test",
    "tamper": "node scripts/verify-receipt.mjs web/sample-run.json --tamper",
    "capture": "node scripts/capture-sample.mjs",
    "sync": "./sync.sh",
    "verify:extreme": "node scripts/verify-receipt.mjs web/sample-extreme.json",
    "verify:ask": "node scripts/verify-receipt.mjs web/sample-ask.json",
    "vendor": "npx -y esbuild@0.24.0 vendor-src/noble.js --bundle --format=esm --minify --legal-comments=inline --outfile=web/vendor/noble.js"
  },
  "devDependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@noble/ciphers": "1.3.0"
  }
